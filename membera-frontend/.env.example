# API Gateway (Membera.Gateway, YARP reverse proxy). Run its "https" profile.
# It forwards /api/auth + /api/admin to the Auth service and
# /api/merchant + /api/subscription-plans + /api/subscriptions to the Merchant
# service, with the full request path preserved.
VITE_API_URL=https://localhost:7174/api

# Google OAuth 2.0 Web client id (public). Must match the Auth API's
# Google:ClientId, and http://localhost:5173 must be an authorized JavaScript
# origin for it.
VITE_GOOGLE_CLIENT_ID=300113136297-8bemuk3ei6hbo64qbd3u9lqem757inkd.apps.googleusercontent.com
