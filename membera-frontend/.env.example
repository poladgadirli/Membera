# Auth API (login, register, account). Run the Auth service's "https" profile.
VITE_AUTH_API_URL=https://localhost:7214/api

# Merchant API (plans, subscriptions, redemptions). Run its "https" profile.
VITE_MERCHANT_API_URL=https://localhost:7241/api

# Google OAuth 2.0 Web client id (public). Must match the Auth API's
# Google:ClientId, and http://localhost:5173 must be an authorized JavaScript
# origin for it.
VITE_GOOGLE_CLIENT_ID=300113136297-8bemuk3ei6hbo64qbd3u9lqem757inkd.apps.googleusercontent.com
