{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "merchant-route": {
        "ClusterId": "merchant-cluster",
        "Match": {
          "Path": "/api/merchant/{**catch-all}"
        }
      },
      "subscription-plans-route": {
        "ClusterId": "merchant-cluster",
        "Match": {
          "Path": "/api/subscription-plans/{**catch-all}"
        }
      },
      "subscriptions-route": {
        "ClusterId": "merchant-cluster",
        "Match": {
          "Path": "/api/subscriptions/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "https://localhost:7214/"
          }
        }
      },
      "merchant-cluster": {
        "Destinations": {
          "merchant-destination": {
            "Address": "https://localhost:7241/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}