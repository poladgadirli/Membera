POSTGRES_PASSWORD=your_password_here

# Shared JWT signing key. Auth and Merchant services MUST use the same value.
# Minimum 32 characters (HMAC-SHA256).
# If the key contains a '$', wrap the value in double quotes and escape it as \$,
# otherwise DotNetEnv interpolation will strip part of the key at load time.
JWT_SECRET_KEY=your-secret-key-here-min-32-chars

# JWT issuer / audience. Auth stamps these into every token; Merchant validates
# against them. Must match Auth's appsettings "Jwt" section exactly.
JWT_ISSUER=Membera.Auth
JWT_AUDIENCE=Membera.Clients

STRIPE_SECRET_KEY=sk_test_your_key_here

# Origin of the frontend SPA. Stripe checkout redirects the customer back here
# (/subscription-success and /subscription-cancel) after payment. Defaults to the
# Vite dev server if unset.
FRONTEND_BASE_URL=http://localhost:5173

MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password